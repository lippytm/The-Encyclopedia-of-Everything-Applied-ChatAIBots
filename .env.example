# .env.example — AI Deployment Activation environment template
# Copy to .env and fill in your values. NEVER commit .env to git.

# ========== ElevenLabs Audiobook Pipeline ==========
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
LIPPYTMAI_VOICE_ID=replace-with-lippytmai-voice-id

# ========== ADA PostgreSQL Database ==========
ADA_DB_NAME=adadb
ADA_DB_USER=postgres
ADA_DB_PASSWORD=replace-with-strong-password

# ========== GESN Credential System ==========
BASE_RPC_URL=https://mainnet.base.org
ADA_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
WALLET_PRIVATE_KEY=replace-with-wallet-private-key

# ========== ADA Web API ==========
ADA_API_PORT=8000
ADA_REGISTRY_PATH=ada-registry.json

# ========== ACSS / Hermes ==========
SLACK_BOT_TOKEN=replace-with-slack-bot-token
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
HERMES_WEBHOOK_URL=replace-with-hermes-webhook-url
